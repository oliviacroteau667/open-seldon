# API backend URL (used by Next.js rewrites; defaults to Docker service name)
API_INTERNAL_URL=http://openseldon-api:8000

# Region GeoJSON for choropleth layer.
# Defaults to Poland voivodeships. Override for other deployments.
# The GeoJSON features must have a "name" property (or set NEXT_PUBLIC_REGION_NAME_PROP).
#
# Examples:
#   Poland voivodeships (default):
#   NEXT_PUBLIC_REGION_GEOJSON_URL=https://raw.githubusercontent.com/ppatrzyk/polska-geojson/master/województwa/województwa-medium.geojson
#
#   Ukraine oblasts:
#   NEXT_PUBLIC_REGION_GEOJSON_URL=https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson
#
#   Any other admin-1 GeoJSON from GADM, Natural Earth, etc.
NEXT_PUBLIC_REGION_GEOJSON_URL=

# Property key in region GeoJSON features that holds the region name
# Defaults to "name" — change if your GeoJSON uses a different key
NEXT_PUBLIC_REGION_NAME_PROP=name

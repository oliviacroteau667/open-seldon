# ============================================================
# Open Seldon environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Postgres (API) ---
POSTGRES_DB=openseldon
POSTGRES_USER=openseldon_api
# postgres_password secret is read from ./secrets/postgres_password

# --- API ---
# Bearer tokens on protected endpoints are verified against this OIDC issuer/audience
OIDC_ISSUER=https://accounts.openseldon.org/application/o/openseldon/
OIDC_AUDIENCE=openseldon-web
OPENROUTER_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
API_KEY=
SENTRY_DSN=

# --- Authentik (identity provider) ---
# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=

# Initial admin credentials (only used on first boot)
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# Authentik's own Postgres credentials
AUTHENTIK_POSTGRES_PASSWORD=
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_DB=authentik

# Outgoing email via Resend (required for magic-link login).
# Password is a Resend API key; openseldon.org must be a verified domain in Resend.
AUTHENTIK_EMAIL_HOST=smtp.resend.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USERNAME=resend
AUTHENTIK_EMAIL_PASSWORD=
AUTHENTIK_EMAIL_USE_TLS=true
AUTHENTIK_EMAIL_FROM=noreply@openseldon.org

# --- OIDC client (Next.js web app) ---
# Generate with: openssl rand -hex 32
OPENSELDON_WEB_CLIENT_SECRET=
# Redirect URIs are declared in deploy/authentik/blueprints/openseldon-signin.yaml

# --- NextAuth.js (web/.env.local) ---
NEXTAUTH_URL=https://openseldon.org
NEXTAUTH_SECRET=
AUTHENTIK_ISSUER=https://accounts.openseldon.org/application/o/openseldon/
AUTHENTIK_CLIENT_ID=openseldon-web
AUTHENTIK_CLIENT_SECRET=   # same as OPENSELDON_WEB_CLIENT_SECRET above

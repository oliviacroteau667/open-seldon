# OpenRouter (used for all LLM calls — pipeline + chatbot)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telegram API (from my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# PostgreSQL (used by the API container)
POSTGRES_HOST=openseldon-postgres
POSTGRES_PORT=5432
POSTGRES_DB=openseldon
POSTGRES_USER=openseldon_api
POSTGRES_PASSWORD=changeme_in_production

# API
API_KEY=changeme_generate_with_openssl_rand_hex_32

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
